{
  "manifest_version": 3,
  "name": "SafePeek",
  "version": "0.3.0",
  "description": "See what a website is built with and how safely it handles your data. Runs entirely in your browser.",
  "homepage_url": "https://github.com/isamu/SafePeek",
  "permissions": ["activeTab", "scripting"],
  "action": {
    "default_title": "SafePeek",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; connect-src 'self'"
  }
}
