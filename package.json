{
  "name": "safepeek",
  "version": "0.9.0",
  "private": true,
  "description": "Browser extension that shows what a website is built with and how safely it handles your data. Runs entirely in the browser.",
  "homepage": "https://github.com/isamu/SafePeek",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/isamu/SafePeek.git"
  },
  "license": "GPL-3.0-or-later",
  "author": "isamu",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json",
    "test": "node --test \"test/*.test.js\"",
    "knip": "knip",
    "duplication": "npx --yes jscpd@4 extension tools test --format javascript --reporters console",
    "update-data": "node tools/update-data.mjs",
    "test:e2e": "node --test \"test/e2e/*.e2e.js\""
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/chrome": "^0.3.4",
    "@types/node": "^26.6.3",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-sonarjs": "^4.2.2",
    "globals": "^17.12.0",
    "knip": "^6.38.0",
    "playwright": "^1.63.0",
    "prettier": "^3.9.9",
    "typescript": "^6.0.3"
  }
}
